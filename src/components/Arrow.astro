---
// Small line icons. kind: 'right' | 'left' | 'out' | 'down'
const { kind = 'right' } = Astro.props;
const paths = {
  right: ['M3 8h10', 'M9 4l4 4-4 4'],
  left: ['M13 8H3', 'M7 4L3 8l4 4'],
  out: ['M5 11l6-6', 'M6 5h5v5'],
  down: ['M8 2v9', 'M4 7.5 8 11.5l4-4', 'M3 14h10'],
};
---
<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths[kind].map((d) => <path d={d} />)}
</svg>
