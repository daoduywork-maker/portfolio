---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Media from '../../components/Media.astro';
import { url } from '../../lib/url.js';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" current="projects" footerLine="Want to talk about a project? Write to me.">
  <section class="wrap page-head">
    <div class="eyebrow">Projects</div>
    <h1 class="page-title">Projects</h1>
    <p class="lede">Ongoing and finished work that is not a published paper. Each one opens its own page with the question, the method, the results and the code.</p>
  </section>

  <section class="wrap rows">
    {projects.map((p) => (
      <article class="row">
        <div class="when">{p.data.status}</div>
        <div class="body">
          <div class="meta">
            <span class="pill pill-project">Project</span>
            {p.data.tags.map((t) => <span class="pill">{t}</span>)}
          </div>
          <h2><a href={url(`projects/${p.id}/`)}>{p.data.title}</a></h2>
          <p class="summary">{p.data.summary}</p>
          <div class="links">
            <a class="text-link" href={url(`projects/${p.id}/`)}>Open project <Arrow /></a>
            {p.data.links.map((l) => <a class="text-link plain" href={l.href}>{l.label}</a>)}
          </div>
        </div>
        <Media figure={p.data.figure} label={p.data.figureLabel} alt={p.data.title} />
      </article>
    ))}
    <div class="rows-foot">
      <p>Published papers have their own page.</p>
      <a class="btn" href={url('research/')}>See peer-reviewed research <Arrow /></a>
    </div>
  </section>
</Base>
